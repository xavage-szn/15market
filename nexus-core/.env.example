# ─── Network ───────────────────────────────────────────
PORT=3010
ROUNDS_PORT=3011

# ─── Arc Testnet ────────────────────────────────────────
CHAIN_ID=5042002
ARC_RPC_1=https://5042002.rpc.thirdweb.com
ARC_RPC_2=https://arc-testnet.g.alchemy.com/v2/YOUR_KEY
ARC_RPC_3=https://rpc.testnet.arc.network
ARC_RPC_4=https://arc-testnet.drpc.org
THIRDWEB_SECRET_KEY=

PRIVATE_KEY=
ARC_CONTRACT_ADDRESS=
ROUNDS_CONTRACT_ADDRESS=

# ─── Classic Trade Tuning ───────────────────────────────
DEFAULT_SESSION_BALANCE=1000
DEFAULT_MULTIPLIER=1.95
SETTLEMENT_BATCH_WINDOW_MS=25
SETTLEMENT_CONCURRENCY=16
PAYOUT_INLINE_FALLBACK=true

# ─── Privy (optional) ───────────────────────────────────
USE_PRIVY_SMART_WALLETS=false
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── Redis (optional — falls back to in-process) ────────
REDIS_URL=redis://localhost:6379

# ─── Vault ──────────────────────────────────────────────
SYSTEM_PASSPHRASE=
FORCE_MACHINE_SEED=
