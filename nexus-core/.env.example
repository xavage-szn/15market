# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Production (Render): https://15market.online
# Development: add http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://15market.online,https://api.15market.online
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis — backs the session balance cache, the open-trade ledger and chart
# history. Without it those features degrade; see src/cache.js, which is bounded
# and logs rather than hanging so a dead endpoint cannot stall a request.
#
# Use the rediss:// scheme. TLS is mandatory on Upstash and on any managed
# provider that terminates TLS, so a plain redis:// URL will never connect.
#
# Render: set REDIS_URL on the 15market-backend service. render.yaml pulls it
# with `fromContext: env`, so the dashboard value is the one that takes effect.
REDIS_URL=
