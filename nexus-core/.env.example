# ─── Server Configuration ──────────────────────────────────
PORT=3010
ROUNDS_PORT=3011
PRICE_FRONTEND_PORT=3012
PRICE_BACKEND_PORT=3013

# ─── Arc Testnet ──────────────────────────────────────────
CHAIN_ID=5042002
ARC_RPC_1=https://rpc.testnet.arc.network
ARC_CONTRACT_ADDRESS=0x345014899b42bF9034D9475760609e64B1433A6a
ROUNDS_CONTRACT_ADDRESS=0x02AE9D2a7CEca436E7B3A482772EfB74C4fE4721
TREASURY_ADDRESS=0x345014899b42bF9034D9475760609e64B1433A6a

# ─── Authentication & Security ─────────────────────────────
# Derivation secret for embedded session wallets
SESSION_MASTER_SECRET=
# Operator private key for on-chain settlements
PRIVATE_KEY=

# ─── Infrastructure ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Price Oracles ─────────────────────────────────────────
# Optional: Pyth Hermes API key (required by Pyth since 2026-08-26).
# When set, price feeds use the authenticated endpoint (pyth.dourolabs.app/hermes).
# Without it, feeds fall back to Binance -> MEXC -> CoinGecko.
PYTH_API_KEY=

# ─── Trading Engine Tuning ────────────────────────────────
DEFAULT_SESSION_BALANCE=1000
DEFAULT_MULTIPLIER=1.95
SETTLEMENT_BATCH_WINDOW_MS=25
SETTLEMENT_CONCURRENCY=16
PAYOUT_INLINE_FALLBACK=true

# ─── Circle Programmable Wallets ───────────────────────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
