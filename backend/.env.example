PORT=3010
DEFAULT_SESSION_BALANCE=1000

# Settlement tuning
SETTLEMENT_BATCH_WINDOW_MS=25
SETTLEMENT_CONCURRENCY=16
DEFAULT_MULTIPLIER=1.95

# Payout worker
PAYOUT_INLINE_FALLBACK=true
PAYOUT_WORKER_POLL_MS=15
PAYOUT_WORKER_BATCH_SIZE=32
BACKEND_INTERNAL_URL=http://127.0.0.1:3010

# Privy embedded wallet mode
USE_PRIVY_SMART_WALLETS=false
PRIVY_APP_ID=
PRIVY_APP_SECRET=
