VITE_SOLANA_READ_RPC=https://api.mainnet-beta.solana.com

# Arc Network
VITE_ARC_RPC=https://rpc.quicknode.testnet.arc.network
VITE_ARC_CONTRACT_ADDRESS=0x041e80256b3C72a0e16d78753F28f14A40d78c08
VITE_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Reown (WalletConnect) Project ID
VITE_REOWN_PROJECT_ID=c57ca95b47569778a828d19178114f4d

# Keeper Backend URL (will be your production domain)
VITE_KEEPER_URL=https://api.15market.online

# Admin Token (CHANGE THIS TO A SECURE RANDOM STRING)
VITE_ADMIN_TOKEN=15MARKET_ADMIN_SECRET_KEY_2024


# ============================================
# BACKEND SECRETS (Keeper)
# ============================================

# Solana Keeper Configuration
NETWORK=https://api.mainnet-beta.solana.com
READ_RPC=https://api.mainnet-beta.solana.com
PROGRAM_ID=YOUR_DEPLOYED_SOLANA_PROGRAM_ID_HERE

# Arc Keeper Configuration
ARC_RPC=https://rpc.quicknode.testnet.arc.network
ARC_CONTRACT_ADDRESS=0x041e80256b3C72a0e16d78753F28f14A40d78c08
CONTRACT_ADDRESS=0x041e80256b3C72a0e16d78753F28f14A40d78c08

# Keeper Wallet Private Keys (KEEP THESE SECURE!)
# For Solana: This will be loaded from keeper-keypair.json file
# For Arc: EVM private key
PRIVATE_KEY=YOUR_ARC_KEEPER_WALLET_PRIVATE_KEY_HERE

# Keeper Settings
MIN_BET_ID=0
PORT=8080
NODE_ENV=production

# X (Twitter) OAuth (Optional - for social features)
X_CLIENT_ID=YOUR_X_OAUTH_CLIENT_ID_HERE
X_CLIENT_SECRET=YOUR_X_OAUTH_CLIENT_SECRET_HERE


# ============================================
# NOTES FOR PRODUCTION:
# ============================================
# 1. SOLANA_RPC: Use a paid RPC provider for production (QuickNode, Helius, Alchemy)
#    Free tier: https://api.mainnet-beta.solana.com (rate limited)
#    Recommended: https://your-project.solana-mainnet.quiknode.pro/YOUR_TOKEN/
#
# 2. ARC_RPC: Currently using testnet. Update when mainnet is available.
#
# 3. PRIVATE_KEY: Generate a new secure wallet for production keeper
#    - Fund it with enough SOL/ARC for gas fees
#    - NEVER commit this to GitHub
#
# 4. VITE_ADMIN_TOKEN: Generate a strong random token:
#    - Use: openssl rand -hex 32
#    - Or: https://www.random.org/strings/
#
# 5. PROGRAM_ID: Your deployed Solana program ID from anchor deploy
#
# 6. For Solana keeper, you'll also need to upload keeper-keypair.json
#    as a secret file in Doppler or mount it as a volume in Docker
# ============================================


# ============================================
# QUICK SETUP COMMANDS (After filling values above)
# ============================================
# 
# Option 1: Manual entry in Doppler UI
# - Copy each line above
# - In Doppler, click "Add Secret"
# - Paste the key name (e.g., VITE_SOLANA_RPC)
# - Paste the value
# - Click Save
#
# Option 2: Bulk upload via Doppler CLI
# 1. Save this file as .env.prod (with real values)
# 2. Run: doppler secrets upload .env.prod --project 15market --config prod
# 3. Delete .env.prod after upload for security
#
