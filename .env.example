# 15market Environment Variables Example
# Copy this file to .env and fill in the values

# --- FRONTEND (UI & ADMIN) ---
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
VITE_SOLANA_READ_RPC=https://api.mainnet-beta.solana.com
VITE_ARC_RPC=https://rpc.arc.network
VITE_ARC_CONTRACT_ADDRESS=0x...
VITE_ARC_USDC_ADDRESS=0x...
VITE_REOWN_PROJECT_ID=your_reown_project_id
VITE_KEEPER_URL=https://api.15market.online
VITE_ADMIN_TOKEN=your_secure_admin_token

# --- BACKEND (KEEPER) ---
NETWORK=https://api.mainnet-beta.solana.com
READ_RPC=https://api.mainnet-beta.solana.com
PROGRAM_ID=your_solana_program_id
ARC_RPC=https://rpc.arc.network
ARC_CONTRACT_ADDRESS=0x...
CONTRACT_ADDRESS=0x...
PRIVATE_KEY=your_arc_keeper_private_key
MIN_BET_ID=0
PORT=8080
NODE_ENV=production

# X OAuth (Optional)
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
