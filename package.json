{
    "name": "15market-monorepo",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "npm run build:ui && npm run build:admin",
        "build:ui": "cd 15market-ui && npm run build",
        "build:admin": "cd 15market-admin && npm run build",
        "start": "concurrently -n \"ARC,ADMIN,UI\" -c \"magenta,green,cyan\" \"npm run start:arc\" \"npm run start:admin\" \"npm run start:ui\"",
        "start:arc": "cd backend/arc-keeper && npm start",
        "start:admin": "cd 15market-admin && npm run dev",
        "start:ui": "cd 15market-ui && npm run dev"
    },
    "devDependencies": {
        "concurrently": "^9.1.2"
    }
}