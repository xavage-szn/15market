#[program]
pub mod sol_prediction {
    use super::*;

    pub fn initialize_market(ctx: Context<InitializeMarket>) -> Result<()> {
        let market = &mut ctx.accounts.market;
        market.authority = ctx.accounts.authority.key();
        market.bump = ctx.bumps.market;
        ctx.accounts.treasury.bump = ctx.bumps.treasury;
        Ok(())
    }

    pub fn place_bet(ctx: Context<PlaceBet>, direction: u8, amount_lamports: u64, entry_price: u64, nonce: u64, duration: u8) -> Result<()> {
        require!(direction <= 1, ErrorCode::InvalidDirection);
        require!(amount_lamports > 0, ErrorCode::InvalidAmount);
        require!(duration == 5 || duration == 10 || duration == 15, ErrorCode::InvalidDuration);

        // Send stake directly to treasury (not to bet PDA)
        // This ensures immediate treasury funding and simpler accounting
        anchor_lang::system_program::transfer(
            CpiContext::new(
                ctx.accounts.system_program.to_account_info(),
                anchor_lang::system_program::Transfer {
                    from: ctx.accounts.user.to_account_info(),
                    to: ctx.accounts.treasury.to_account_info(),  // ✅ REDESIGN: Goes to Treasury
                },
            ),
            amount_lamports,
        )?;

        let bet = &mut ctx.accounts.bet;
        bet.owner = ctx.accounts.user.key();
        bet.amount_lamports = amount_lamports;
        bet.direction = direction;
        bet.entry_price = entry_price;
        bet.nonce = nonce;
        bet.duration = duration;
        bet.timestamp = Clock::get()?.unix_timestamp;
        bet.resolved = false;
        bet.bump = ctx.bumps.bet;

        Ok(())
    }

    pub fn sync_profile(
        ctx: Context<SyncProfile>,
        username: String,
        x_handle: String,
        discord_handle: String
    ) -> Result<()> {
        let profile = &mut ctx.accounts.profile;
        require!(username.len() <= 32, ErrorCode::UsernameTooLong);
        
        profile.owner = ctx.accounts.user.key();
        profile.username = username;
        profile.x_handle = x_handle;
        profile.discord_handle = discord_handle;
        
        if profile.total_trades == 0 {
            profile.total_wins = 0;
            profile.total_losses = 0;
            profile.total_volume = 0;
        }

        Ok(())
    }

    pub fn withdraw_treasury(ctx: Context<WithdrawTreasury>, amount_lamports: u64) -> Result<()> {
        let market = &ctx.accounts.market;
        require!(ctx.accounts.authority.key() == market.authority, ErrorCode::Unauthorized);
        
        let treasury_info = ctx.accounts.treasury.to_account_info();
        require!(treasury_info.lamports() >= amount_lamports, ErrorCode::InsufficientTreasury);

        **ctx.accounts.treasury.to_account_info().try_borrow_mut_lamports()? -= amount_lamports;
        **ctx.accounts.authority.to_account_info().try_borrow_mut_lamports()? += amount_lamports;

        Ok(())
    }

    pub fn settle_bet(ctx: Context<SettleBet>, user_won: bool) -> Result<()> {
        let bet = &mut ctx.accounts.bet;
        require!(!bet.resolved, ErrorCode::AlreadySettled);
        
        let bet_amount = bet.amount_lamports;
        
        // Dynamic Multiplier based on duration
        // 15s: 1.98x payout (98% profit)
        // 10s: 4.98x payout (398% profit)
        // 5s:  6.98x payout (598% profit)
        let multiplier_bp = match bet.duration {
            5 => 698,
            10 => 498,
            _ => 198,
        };

        let payout = bet_amount.checked_mul(multiplier_bp).unwrap().checked_div(100).unwrap(); 

        bet.resolved = true;

        if user_won {
            // ✅ REDESIGN: Pay full payout from treasury (includes original stake + profit)
            // Since stake is already in treasury, we pay the full payout amount
            let treasury_info = ctx.accounts.treasury.to_account_info();
            let treasury_lamports = treasury_info.lamports();
            
            require!(treasury_lamports >= payout, ErrorCode::InsufficientTreasury);

            // Transfer full payout from treasury to user
            **ctx.accounts.treasury.to_account_info().try_borrow_mut_lamports()? -= payout;
            **ctx.accounts.owner.to_account_info().try_borrow_mut_lamports()? += payout;
        } else {
            // ✅ REDESIGN: User lost - stake is already in treasury
            // No transfer needed, treasury keeps the stake
            // Bet account will close and return rent to user
        }

        // Update profile if provided
        if let Some(profile_info) = ctx.remaining_accounts.get(0) {
            if profile_info.owner == ctx.program_id {
                let mut data = profile_info.try_borrow_mut_data()?;
                let mut profile = UserProfile::try_deserialize(&mut &data[..])?;
                
                if profile.owner == ctx.accounts.owner.key() {
                    profile.total_trades += 1;
                    profile.total_volume += bet_amount;
                    if user_won {
                        profile.total_wins += 1;
                    } else {
                        profile.total_losses += 1;
                    }
                    profile.try_serialize(&mut &mut data[..])?;
                }
            }
        }

        Ok(())
    }
}

#[derive(Accounts)]
pub struct InitializeMarket<'info> {
    #[account(init, payer = authority, space = 8 + Market::LEN, seeds = [b"market_v2"], bump)]
    pub market: Account<'info, Market>,
    #[account(
        init_if_needed, 
        payer = authority, 
        space = 8 + Treasury::LEN, 
        seeds = [b"treasury"], 
        bump
    )]
    pub treasury: Account<'info, Treasury>,
    #[account(mut)]
    pub authority: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
#[instruction(direction: u8, amount_lamports: u64, entry_price: u64, nonce: u64, duration: u8)]
pub struct PlaceBet<'info> {
    #[account(
        init, 
        payer = user, 
        space = 8 + Bet::LEN, 
        seeds = [b"bet_v6", user.key().as_ref(), nonce.to_le_bytes().as_ref()], 
        bump
    )]
    pub bet: Account<'info, Bet>,
    #[account(seeds = [b"market_v2"], bump = market.bump)]
    pub market: Account<'info, Market>,
    #[account(mut, seeds = [b"treasury"], bump = treasury.bump)]
    pub treasury: Account<'info, Treasury>,
    #[account(mut)]
    pub user: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct SyncProfile<'info> {
    #[account(
        init_if_needed, 
        payer = user, 
        space = 8 + UserProfile::LEN, 
        seeds = [b"user-profile", user.key().as_ref()], 
        bump
    )]
    pub profile: Account<'info, UserProfile>,
    #[account(mut)]
    pub user: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct WithdrawTreasury<'info> {
    #[account(seeds = [b"market_v2"], bump = market.bump)]
    pub market: Account<'info, Market>,
    #[account(mut, seeds = [b"treasury"], bump = treasury.bump)]
    pub treasury: Account<'info, Treasury>,
    #[account(mut)]
    pub authority: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct SettleBet<'info> {
    #[account(
        mut, 
        close = owner, 
        seeds = [b"bet_v6", bet.owner.as_ref(), bet.nonce.to_le_bytes().as_ref()], 
        bump = bet.bump
    )]
    pub bet: Account<'info, Bet>,
    #[account(mut)]
    pub owner: SystemAccount<'info>,
    #[account(mut, seeds = [b"treasury"], bump = treasury.bump)]
    pub treasury: Account<'info, Treasury>,
    #[account(signer)]
    pub keeper: Signer<'info>,
    pub system_program: Program<'info, System>,
}

#[account]
pub struct Market {
    pub authority: Pubkey,
    pub bump: u8,
}
impl Market { pub const LEN: usize = 32 + 1; }

#[account]
pub struct Treasury {
    pub bump: u8,
}
impl Treasury { pub const LEN: usize = 1; }

#[account]
pub struct Bet {
    pub owner: Pubkey,
    pub amount_lamports: u64,
    pub direction: u8,
    pub entry_price: u64,
    pub nonce: u64,
    pub duration: u8,
    pub timestamp: i64,
    pub resolved: bool,
    pub bump: u8,
}
impl Bet { pub const LEN: usize = 32 + 8 + 1 + 8 + 8 + 1 + 8 + 1 + 1; }

#[account]
pub struct UserProfile {
    pub owner: Pubkey,
    pub username: String,
    pub x_handle: String,
    pub discord_handle: String,
    pub total_wins: u64,
    pub total_losses: u64,
    pub total_trades: u64,
    pub total_volume: u64,
}
impl UserProfile {
    pub const LEN: usize = 32 + (4 + 32) + (4 + 32) + (4 + 32) + 8 + 8 + 8 + 8;
}

#[error_code]
pub enum ErrorCode {
    #[msg("Invalid bet direction")]
    InvalidDirection,
    #[msg("Invalid bet amount")]
    InvalidAmount,
    #[msg("Bet already settled")]
    AlreadySettled,
    #[msg("Unauthorized")]
    Unauthorized,
    #[msg("Username too long")]
    UsernameTooLong,
    #[msg("Invalid duration")]
    InvalidDuration,
    #[msg("Insufficient treasury funds")]
    InsufficientTreasury,
}
