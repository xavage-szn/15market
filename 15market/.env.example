# Network Configuration
VITE_ARC_CONTRACT_ADDRESS=0x345014899b42bF9034D9475760609e64B1433A6a
VITE_ARC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ARC_RPC=https://rpc.testnet.arc.network

# API / Keeper URL
# Use absolute URL (http...) or relative path (/...)
VITE_KEEPER_URL=https://api.15market.online
VITE_KEEPER_URL_ARC=https://api.15market.online/arc

# Security
VITE_ADMIN_TOKEN=15MARKET_ADMIN_SECRET_KEY_2024

# Privy (wallet auth) — REQUIRED. Without a valid app ID the app crashes
# at startup ("Cannot initialize the Privy provider with an invalid Privy
# app ID"). Public client ID — safe to commit.
VITE_PRIVY_APP_ID=cmisfdm6o00j9jr0d2tjntq58

# Reown / WalletConnect Project ID
VITE_REOWN_PROJECT_ID=4aebd2ef806c541b6aaf003da2930c58

# Optional: Pyth Hermes API key (required by Pyth since 2026-08-26 for the
# direct browser price stream). Without it the UI falls back to the backend
# socket price feed (Pyth -> Binance -> MEXC -> CoinGecko).
VITE_PYTH_API_KEY=

# OneSignal phone notifications (web push)
# Public App ID — safe to commit (the REST API key lives server-side in nexus-core).
VITE_ONESIGNAL_APP_ID=
